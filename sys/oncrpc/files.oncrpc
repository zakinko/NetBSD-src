#	$NetBSD$

define	xdr

defflag				ONCRPC: xdr, aes, des
# Out of RFC 5403 on purpose: take SHA-1 for the hash of RPCSEC_GSS
# channel bindings.  Without it only SHA-256 is.
defflag	opt_oncrpc.h		ONCRPC_GSS_CB_SHA1
# Out of RFC 5403 s9 on purpose: bind contexts whose MIC is narrower
# than the widest Kerberos checksum.
defflag	opt_oncrpc.h		ONCRPC_GSS_CB_ANYMIC
# Out of RFC 9289 s5.1.2 on purpose: establish DTLS associations that
# carry no connection ID, where the RFC says each handshake MUST
# negotiate a nonzero one.  OpenSSL, which rpc.tlsservd uses, does not
# implement connection IDs for DTLS 1.3 (openssl/openssl#18724 is still
# open, and its DTLS 1.3 design document leaves them out), so without
# this no client built on it can associate.  The kernel's record layer
# handles connection IDs either way: to go back to the RFC, drop this
# option, and a handshake without them is refused at NFSSVC_TLSDONE.
defflag	opt_oncrpc.h		ONCRPC_DTLS_NOCID
# Records sent under one TLS key before our KeyUpdate; at most 2^24.
defparam opt_oncrpc.h		ONCRPC_TLS_REKEY

file	oncrpc/oncrpc_auth.c		oncrpc
file	oncrpc/oncrpc_clnt.c		oncrpc
file	oncrpc/oncrpc_dtls.c		oncrpc
file	oncrpc/gss_krb5.c		oncrpc
file	oncrpc/gss_krb5_crypto.c	oncrpc
file	oncrpc/oncrpc_gss.c		oncrpc
file	oncrpc/oncrpc_gss_clnt.c	oncrpc
file	oncrpc/oncrpc_gss_svc.c		oncrpc
file	oncrpc/oncrpc_gssd.c		oncrpc
file	oncrpc/oncrpc_msg.c		oncrpc
file	oncrpc/oncrpc_rm.c		oncrpc
file	oncrpc/oncrpc_svc.c		oncrpc
file	oncrpc/oncrpc_tls.c		oncrpc
file	oncrpc/tls13_crypto.c		oncrpc
file	oncrpc/xdr_mbuf.c		xdr
file	oncrpc/xdr_module.c		xdr

prefix	../common/lib/libc/rpc
file	xdr.c				xdr
file	xdr_array.c			xdr
file	xdr_mem.c			xdr
prefix

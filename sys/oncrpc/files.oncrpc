#	$NetBSD$

define	xdr

defflag				ONCRPC: xdr, aes, des
# Out of RFC 5403 on purpose: take SHA-1 for the hash of RPCSEC_GSS
# channel bindings.  Without it only SHA-256 is.
defflag	opt_oncrpc.h		ONCRPC_GSS_CB_SHA1

file	oncrpc/oncrpc_auth.c		oncrpc
file	oncrpc/oncrpc_clnt.c		oncrpc
file	oncrpc/gss_krb5.c		oncrpc
file	oncrpc/gss_krb5_crypto.c	oncrpc
file	oncrpc/oncrpc_gss.c		oncrpc
file	oncrpc/oncrpc_gss_clnt.c	oncrpc
file	oncrpc/oncrpc_gss_svc.c		oncrpc
file	oncrpc/oncrpc_gssd.c		oncrpc
file	oncrpc/oncrpc_msg.c		oncrpc
file	oncrpc/oncrpc_rm.c		oncrpc
file	oncrpc/oncrpc_svc.c		oncrpc
file	oncrpc/oncrpc_tls.c		oncrpc
file	oncrpc/tls13_crypto.c		oncrpc
file	oncrpc/xdr_mbuf.c		xdr
file	oncrpc/xdr_module.c		xdr

prefix	../common/lib/libc/rpc
file	xdr.c				xdr
file	xdr_array.c			xdr
file	xdr_mem.c			xdr
prefix
